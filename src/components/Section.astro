---
// Sección de la portada con título numerado (el número va en naranja).
interface Props {
  id: string;
  numero: string;
  titulo: string;
}
const { id, numero, titulo } = Astro.props;
---

<section id={id} class="section container" aria-labelledby={`${id}-titulo`}>
  <header class="section-head reveal">
    <span class="num" aria-hidden="true">{numero}</span>
    <h2 id={`${id}-titulo`}>{titulo}</h2>
  </header>
  <div class="section-body">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-top: var(--section-gap);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .num {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  h2 {
    font-size: clamp(2rem, 6vw, 3rem);
  }
</style>
