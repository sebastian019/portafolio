---
// Encabezado fijo con navegación a las secciones de la portada.
import { url } from '../utils/url';

const links = [
  { href: url('/#proyectos'), label: 'Proyectos' },
  { href: url('/#sobre-mi'), label: 'Sobre mí' },
  { href: url('/#experiencia'), label: 'Experiencia' },
  { href: url('/#contacto'), label: 'Contacto' },
];
---

<header class="site-header">
  <div class="container inner">
    <a href={url('/')} class="brand" aria-label="Inicio">
      S<span>.</span>G
    </a>
    <nav aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href} data-nav={l.href.split('#')[1]}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Resalta en naranja el enlace de la sección que se está viendo.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const sections = [...navLinks]
    .map((a) => document.getElementById(a.dataset.nav ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = entry.target.id;
          if (entry.isIntersecting) {
            navLinks.forEach((a) => a.toggleAttribute('aria-current', a.dataset.nav === id));
          } else {
            // Al salir de la sección (p. ej. volviendo a la portada) se desmarca.
            navLinks.forEach((a) => a.dataset.nav === id && a.removeAttribute('aria-current'));
          }
        }
      },
      // Cuenta como "actual" la sección que cruza la franja central de la pantalla.
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Tinte cálido: un brillo naranja muy suave desde la marca */
    background:
      radial-gradient(28rem 6rem at 10% 0%, rgba(242, 140, 56, 0.1), transparent 70%),
      rgba(22, 18, 16, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  /* Línea inferior con degradado naranja que se desvanece en los bordes */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(196, 101, 31, 0.6) 25%,
      rgba(255, 179, 107, 0.7) 50%,
      rgba(196, 101, 31, 0.6) 75%,
      transparent
    );
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .brand span {
    color: var(--accent);
    text-shadow: 0 0 12px rgba(242, 140, 56, 0.6);
  }
  ul {
    display: flex;
    gap: clamp(0.9rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  /* Subrayado naranja que crece desde el centro */
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.3s var(--ease);
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--text);
  }
  nav a:hover::after,
  nav a[aria-current]::after {
    transform: scaleX(1);
  }
  nav a[aria-current] {
    color: var(--accent);
  }
  /* En pantallas muy angostas se ocultan los enlaces secundarios */
  @media (max-width: 30rem) {
    li:nth-child(2),
    li:nth-child(3) {
      display: none;
    }
  }
</style>
