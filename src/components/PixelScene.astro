---
// Escena de pixel art de la portada (personaje original: un pequeño robot).
// Secuencia al cargar: entra caminando, salta, golpea el bloque "?", sale un
// objeto al azar que queda levitando y el robot se va. Un contador suma los
// objetos obtenidos y al hacer clic en el bloque se repite. De fondo, un bosque
// cyberpunk con montañas.
//
// Todo es SVG + CSS. JS ajusta el ancho de la escena al contenedor, agrega la
// clase que inicia la animación y maneja el botón de repetir. Con
// prefers-reduced-motion (o sin JS) se muestra directamente el estado final.
//
// Los sprites se escriben como cuadrículas de texto: cada carácter es un
// píxel y "." es transparente. Se convierten a <rect> al compilar.
import Icon from './Icon.astro';

type Px = { x: number; y: number; w: number; c: string };

/** Convierte una cuadrícula de texto en rects, uniendo píxeles contiguos del mismo color. */
function sprite(rows: string[], ox = 0, oy = 0): Px[] {
  const out: Px[] = [];
  rows.forEach((row, y) => {
    let x = 0;
    while (x < row.length) {
      const c = row[x];
      let w = 1;
      while (c !== '.' && row[x + w] === c) w++;
      if (c !== '.') out.push({ x: ox + x, y: oy + y, w, c });
      x += w;
    }
  });
  return out;
}

// Ancho máximo de la escena en "píxeles" del dibujo; JS muestra solo lo que cabe.
const MAX_COLS = 400;
const SUELO = 56;

// Robot (9 × 12). t: punta de antena · h/b/s: grises cálidos · v: visor · e: ojos · c: luz del pecho
const robotCuerpo = sprite([
  '....t....',
  '....s....',
  '.hhhhhhh.',
  '.hvvvvvh.',
  '.hvevevh.',
  '.bbbbbbb.',
  '...sss...',
  '.bbbcbbb.',
  'sbbbbbbbs',
  '.sssssss.',
]);
// Dos poses de piernas para el paso
const piernasA = sprite(['..ss.ss..', '..hh.hh..'], 0, 10);
const piernasB = sprite(['..ss.ss..', '.hh...hh.'], 0, 10);

// Bloque (12 × 12) con un "?" pixelado propio. o: borde · d: relleno · r: remaches · q: signo
const bloque = sprite([
  '.oooooooooo.',
  'oddddddddddo',
  'odrddddddrdo',
  'oddddqqddddo',
  'odddqddqdddo',
  'oddddddqdddo',
  'odddddqddddo',
  'odddddqddddo',
  'oddddddddddo',
  'odddddqddddo',
  'odrddddddrdo',
  '.oooooooooo.',
], 0, 24);

// Objetos que puede soltar el bloque (7 × 7 cada uno, todos diseño propio).
// y: núcleo · l: claro · a: acento · k: naranja oscuro · d: relleno oscuro
const objetos = {
  brasa: sprite([
    '...l...',
    '..ala..',
    '..ala..',
    '.kalak.',
    '.kayak.',
    '..kak..',
    '...k...',
  ], 3, 15),
  moneda: sprite([
    '..kkk..',
    '.kllak.',
    'klaaaak',
    'klayaak',
    'kaaaaak',
    '.kaaak.',
    '..kkk..',
  ], 3, 15),
  // El engranaje necesita 9 × 9 para que se lean los dientes (mismo centro y base)
  engranaje: sprite([
    '...lal...',
    '.l.lal.a.',
    '..laaaa..',
    'lla...aak',
    'lla...akk',
    'laa...akk',
    '..aaakk..',
    '.a.akk.k.',
    '...akk...',
  ], 2, 13),
  chip: sprite([
    '.l.l.l.',
    'lkkkkkl',
    '.kdddk.',
    'lkdydkl',
    '.kdddk.',
    'lkkkkkl',
    '.l.l.l.',
  ], 3, 15),
  // Dos velas de un gráfico de bolsa: una baja (hueca) y una alza (rellena)
  vela: sprite([
    '.....l.',
    '....aaa',
    '.k..aya',
    'kkk.aya',
    'k.k.aaa',
    'kkk..k.',
    '.k...k.',
  ], 3, 15),
};

// ---------- Bosque cyberpunk (generado al compilar, siempre igual) ----------
// Generador pseudoaleatorio con semilla fija: el dibujo no cambia entre builds.
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type TreePx = { x: number; y: number; w: number; h: number; c: string };

/** Pino escalonado: silueta oscura con borde de neón en el lado izquierdo. */
function pino(cx: number, alto: number, rand: () => number): TreePx[] {
  const px: TreePx[] = [];
  const copa = alto - 2;
  const top = SUELO - alto;
  for (let r = 0; r < copa; r++) {
    const half = Math.floor((r % 5) / 2) + Math.floor(r / 5);
    const y = top + r;
    px.push({ x: cx - half, y, w: half * 2 + 1, h: 1, c: 'leaf' });
    // Neón solo en el borde inferior de cada escalón (lado izquierdo y derecho)
    if (r % 5 === 4 || r === copa - 1) {
      px.push({ x: cx - half, y, w: 1, h: 1, c: 'rim' });
      px.push({ x: cx + half, y, w: 1, h: 1, c: 'rim' });
    }
    if (half > 1 && rand() < 0.12) px.push({ x: cx + Math.round((rand() - 0.5) * half), y, w: 1, h: 1, c: 'led' });
  }
  px.push({ x: cx, y: SUELO - 2, w: 1, h: 2, c: 'leaf' }); // tronco
  return px;
}

/** Árbol de copa redonda con contorno de neón en la mitad superior. */
function redondo(cx: number, alto: number, rand: () => number): TreePx[] {
  const px: TreePx[] = [];
  const R = Math.max(3, Math.min(7, Math.floor(alto / 3)));
  const cy = SUELO - alto + R;
  for (let dy = -R; dy <= R; dy++) {
    const half = Math.floor(Math.sqrt(R * R - dy * dy) + 0.3);
    const y = cy + dy;
    px.push({ x: cx - half, y, w: half * 2 + 1, h: 1, c: 'leaf' });
    if (dy < 0) {
      px.push({ x: cx - half, y, w: 1, h: 1, c: 'rim' });
      px.push({ x: cx + half, y, w: 1, h: 1, c: 'rim' });
    }
    if (half > 1 && rand() < 0.15) px.push({ x: cx + Math.round((rand() - 0.5) * half), y, w: 1, h: 1, c: 'led' });
  }
  px.push({ x: cx, y: cy + R + 1, w: 1, h: SUELO - cy - R - 1, c: 'leaf' }); // tronco
  return px;
}

function bosque(seed: number, paso: [number, number], alto: [number, number], conRedondos: boolean) {
  const rand = rng(seed);
  const px: TreePx[] = [];
  let x = Math.floor(rand() * paso[0]);
  let i = 0;
  while (x < MAX_COLS + 10) {
    const h = alto[0] + Math.floor(rand() * (alto[1] - alto[0]));
    // Alterna pinos y árboles redondos para que no se agrupen
    if (conRedondos && i++ % 2 === 1 && rand() < 0.8) px.push(...redondo(x, h, rand));
    else px.push(...pino(x, h, rand));
    x += paso[0] + Math.floor(rand() * (paso[1] - paso[0]));
  }
  return px;
}

/**
 * Cordillera pixelada: perfil de alturas con picos triangulares (semilla fija).
 * Devuelve dos paths: la silueta en escalera y la cresta (1 px por columna).
 */
function cordillera(seed: number, picos: number, alto: [number, number], pendiente: [number, number]) {
  const rand = rng(seed);
  const cimas = Array.from({ length: picos }, () => ({
    x: rand() * MAX_COLS,
    y: alto[0] + rand() * (alto[1] - alto[0]), // y de la cima (menor = más alta)
    m: pendiente[0] + rand() * (pendiente[1] - pendiente[0]),
  }));
  let silueta = `M0 ${SUELO}`;
  let cresta = '';
  for (let x = 0; x < MAX_COLS; x++) {
    let top = SUELO;
    for (const c of cimas) top = Math.min(top, c.y + Math.abs(x + 0.5 - c.x) * c.m);
    const y = Math.round(top);
    silueta += `V${y}h1`;
    cresta += `M${x} ${y}h1v1h-1z`;
  }
  silueta += `V${SUELO}z`;
  return { silueta, cresta };
}

const montesLejanos = cordillera(3, 9, [12, 24], [0.5, 0.9]);
const montesCercanos = cordillera(11, 12, [26, 36], [0.7, 1.2]);

const bosqueLejano = bosque(7, [9, 16], [12, 20], false);
const bosqueCercano = bosque(21, [20, 36], [16, 28], true);

// Suelo: textura de píxeles sueltos bajo la línea
const suelo = Array.from({ length: MAX_COLS / 8 }, (_, i) => ({ x: i * 8 + (i % 3) * 2 }));

// Estrellas: píxeles sueltos y algunas en cruz. Cada una con un ritmo de
// titileo distinto (t1–t3) y un desfase, para que nunca titilen a la vez.
const estrellas = (() => {
  const rand = rng(42);
  const out: { x: number; y: number; cruz: boolean; ritmo: number; desfase: number; naranja: boolean }[] = [];
  while (out.length < 46) {
    const x = Math.floor(rand() * MAX_COLS);
    const y = 2 + Math.floor(rand() * 20);
    if (x < 26 && y < 11) continue; // deja libre la esquina del contador
    out.push({
      x,
      y,
      cruz: rand() < 0.15,
      ritmo: 1 + Math.floor(rand() * 3),
      desfase: -Math.round(rand() * 90) / 10,
      naranja: rand() < 0.3,
    });
  }
  return out;
})();

// Mini bot dormido (7 × 6). Los ojos van aparte para poder abrir uno.
const miniBot = sprite([
  '...t...',
  '.hhhhh.',
  '.hvvvh.',
  '.bbbbb.',
  'sbbbbbs',
  '.s...s.',
], 0, SUELO - 6);
// Letra "z" de 4 × 4 para los ronquidos (en 3 × 3 se confunde con una "I")
const zeta = sprite(['llll', '..l.', '.l..', 'llll']);
---

<div class="pixel-scene" data-pixel-scene>
  <svg
    class="scene"
    viewBox={`0 0 320 60`}
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
    data-scene
  >
    <defs>
      <radialGradient id="brasa-glow">
        <stop offset="0" style="stop-color: var(--accent); stop-opacity: 0.55" />
        <stop offset="1" style="stop-color: var(--accent); stop-opacity: 0" />
      </radialGradient>
      <linearGradient id="horizonte" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--accent); stop-opacity: 0" />
        <stop offset="1" style="stop-color: var(--accent); stop-opacity: 0.07" />
      </linearGradient>
    </defs>

    <!-- Resplandor del horizonte -->
    <rect x="0" y="20" width={MAX_COLS} height={SUELO - 20} fill="url(#horizonte)" />

    <!-- Estrellas (detrás de las montañas) -->
    <g class="stars">
      {estrellas.map((e) => (
        <g
          class={`star t${e.ritmo} ${e.naranja ? 'star-orange' : 'star-warm'}`}
          style={`animation-delay: ${e.desfase}s`}
        >
          <rect x={e.x} y={e.y} width="1" height="1" />
          {e.cruz && (
            <path class="star-rays" d={`M${e.x - 1} ${e.y}h1v1h-1zM${e.x + 1} ${e.y}h1v1h-1zM${e.x} ${e.y - 1}h1v1h-1zM${e.x} ${e.y + 1}h1v1h-1z`} />
          )}
        </g>
      ))}
    </g>

    <!-- Montañas: dos cordilleras con cresta de neón tenue -->
    <g class="mountains mountains-far">
      <path class="m-body" d={montesLejanos.silueta} />
      <path class="m-ridge" d={montesLejanos.cresta} />
    </g>
    <g class="mountains mountains-near">
      <path class="m-body" d={montesCercanos.silueta} />
      <path class="m-ridge" d={montesCercanos.cresta} />
    </g>

    <!-- Bosque cyberpunk: dos capas para dar profundidad -->
    <g class="forest forest-far">
      {bosqueLejano.map((p) => <rect class={`t-${p.c}`} x={p.x} y={p.y} width={p.w} height={p.h} />)}
    </g>
    <g class="forest forest-near">
      {bosqueCercano.map((p) => <rect class={`t-${p.c}`} x={p.x} y={p.y} width={p.w} height={p.h} />)}
    </g>

    <!-- Suelo -->
    <rect class="ground" x="0" y={SUELO} width={MAX_COLS} height="1" />
    {suelo.map((p) => <rect class="ground-px" x={p.x} y="58" width="1" height="1" />)}

    <!-- Bloque y objeto: JS los mueve en X según el ancho disponible -->
    <g class="poi" transform="translate(154 0)" data-poi>
      <!-- Luz del objeto sobre el suelo: franjas pixeladas que se aclaran al centro -->
      <g class="ground-light">
        <rect x="-6" y={SUELO} width="24" height="1" opacity="0.25" />
        <rect x="-2" y={SUELO} width="16" height="1" opacity="0.45" />
        <rect x="2" y={SUELO} width="8" height="1" opacity="0.8" />
        <rect x="0" y={SUELO + 2} width="12" height="1" opacity="0.15" />
        <rect x="-3" y={SUELO - 1} width="18" height="1" opacity="0.08" />
      </g>
      <!-- El objeto va antes que el bloque para quedar "dentro" de él al inicio.
           Se dibujan los cinco y CSS muestra solo el elegido (data-item). -->
      <g class="ember">
        <circle class="ember-glow" cx="6" cy="18" r="11" fill="url(#brasa-glow)" />
        {Object.entries(objetos).map(([nombre, pixeles]) => (
          <g class={`item item-${nombre}`}>
            {pixeles.map((p) => <rect class={`px-${p.c}`} x={p.x} y={p.y} width={p.w} height="1" />)}
          </g>
        ))}
        <rect class="spark spark-1 px-l" x="2" y="16" width="1" height="1" />
        <rect class="spark spark-2 px-a" x="10" y="14" width="1" height="1" />
      </g>
      <g class="block">
        <g class="block-hop">
          {bloque.map((p) => <rect class={`px-${p.c}`} x={p.x} y={p.y} width={p.w} height="1" />)}
        </g>
      </g>
    </g>

    <!-- Robot: un grupo para el eje X (caminar) y otro para el Y (saltar) -->
    <g class="robot-x">
      <g class="robot-y">
        <g transform="translate(0 44)">
          {robotCuerpo.map((p) => <rect class={`px-${p.c}`} x={p.x} y={p.y} width={p.w} height="1" />)}
          <g class="legs-a">
            {piernasA.map((p) => <rect class={`px-${p.c}`} x={p.x} y={p.y} width={p.w} height="1" />)}
          </g>
          <g class="legs-b">
            {piernasB.map((p) => <rect class={`px-${p.c}`} x={p.x} y={p.y} width={p.w} height="1" />)}
          </g>
        </g>
      </g>
    </g>

    <!-- Mini bot que se queda dormido en el borde derecho cuando el robot se va -->
    <g class="minibot" transform="translate(308 0)" data-minibot>
      <g class="minibot-body">
        {miniBot.map((p) => <rect class={`px-${p.c}`} x={p.x} y={p.y} width={p.w} height="1" />)}
        <!-- Ojos cerrados (párpados) y un ojo que se abre con el cursor -->
        <rect class="eye-closed" x="2" y={SUELO - 4} width="1" height="1" />
        <rect class="eye-closed eye-right" x="4" y={SUELO - 4} width="1" height="1" />
        <rect class="eye-open" x="4" y={SUELO - 4} width="1" height="1" />
      </g>
      <g class="zz">
        <g class="z z-1" transform={`translate(-3 ${SUELO - 11})`}>
          {zeta.map((p) => <rect x={p.x} y={p.y} width={p.w} height="1" />)}
        </g>
        <g class="z z-2" transform={`translate(-3 ${SUELO - 11})`}>
          {zeta.map((p) => <rect x={p.x} y={p.y} width={p.w} height="1" />)}
        </g>
      </g>
    </g>

    <!-- Contador de objetos (lo dibuja JS con dígitos de 3 × 5 px) -->
    <g class="counter" transform="translate(3 3)" data-counter></g>
  </svg>

  <!-- Zona clicable sobre el bloque (botón HTML real: foco, Enter y Espacio) -->
  <button
    type="button"
    class="block-hit"
    data-block-hit
    hidden
    aria-label="Golpear el bloque: sale un objeto nuevo"
    title="Golpear el bloque"
  ></button>

  <!-- Frase ocasional que trae el objeto (se anuncia a lectores de pantalla) -->
  <p class="phrase" data-phrase aria-live="polite"></p>

  <!-- Zona de hover del mini bot (solo decorativa: abre un ojo) -->
  <span class="minibot-hit" data-minibot-hit aria-hidden="true"></span>

  <button type="button" class="replay" data-replay hidden aria-label="Repetir animación" title="Repetir animación">
    <Icon name="replay" size={14} />
  </button>
</div>

<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const OBJETOS = ['brasa', 'moneda', 'engranaje', 'chip', 'vela'];
  // Momento en que el objeto sale del bloque: --delay (0,6 s) + 2,3 s del golpe.
  const SALIDA_MS = 2900;

  // Frases que a veces trae el objeto. Solo estas: no agregar otras inventadas.
  const FRASES = [
    'Buscando práctica profesional 2027',
    'Ask me about multi-agent systems',
    'IA aplicada a finanzas',
  ];
  const PROB_FRASE = 0.4; // "de vez en cuando": ~4 de cada 10 reproducciones
  const FRASE_MS = 3500; // tiempo que queda visible antes de desvanecerse

  // Dígitos pixelados de 3 × 5 (1 = píxel encendido) y una "x" para el contador.
  const GLIFOS: Record<string, string[]> = {
    '0': ['111', '101', '101', '101', '111'],
    '1': ['010', '110', '010', '010', '111'],
    '2': ['111', '001', '111', '100', '111'],
    '3': ['111', '001', '111', '001', '111'],
    '4': ['101', '101', '111', '001', '001'],
    '5': ['111', '100', '111', '001', '111'],
    '6': ['111', '100', '111', '101', '111'],
    '7': ['111', '001', '010', '010', '010'],
    '8': ['111', '101', '111', '101', '111'],
    '9': ['111', '101', '111', '001', '111'],
    x: ['000', '101', '010', '101', '000'],
  };

  document.querySelectorAll<HTMLElement>('[data-pixel-scene]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-scene]')!;
    const poi = root.querySelector<SVGGElement>('[data-poi]')!;
    const counter = root.querySelector<SVGGElement>('[data-counter]')!;
    const button = root.querySelector<HTMLButtonElement>('[data-replay]');
    const blockHit = root.querySelector<HTMLButtonElement>('[data-block-hit]')!;
    const miniBot = root.querySelector<SVGGElement>('[data-minibot]')!;
    const miniBotHit = root.querySelector<HTMLElement>('[data-minibot-hit]')!;
    const phrase = root.querySelector<HTMLElement>('[data-phrase]')!;
    let ultimaFrase = '';
    let fraseTimers: number[] = [];

    const ocultarFrase = () => {
      fraseTimers.forEach(clearTimeout);
      fraseTimers = [];
      phrase.classList.remove('is-visible');
    };

    // A veces, el objeto trae una frase: aparece unos segundos y se desvanece.
    const quizasFrase = (espera: number) => {
      ocultarFrase();
      if (Math.random() >= PROB_FRASE) return;
      const opciones = FRASES.filter((f) => f !== ultimaFrase);
      ultimaFrase = opciones[Math.floor(Math.random() * opciones.length)];
      fraseTimers.push(
        window.setTimeout(() => {
          phrase.textContent = ultimaFrase;
          phrase.lang = ultimaFrase.startsWith('Ask') ? 'en' : 'es';
          phrase.classList.add('is-visible');
        }, espera),
        window.setTimeout(() => phrase.classList.remove('is-visible'), espera + FRASE_MS),
      );
    };

    // El contador vive solo en memoria: no se guarda entre visitas.
    let total = 0;
    let ultimo = '';
    let timer: number | undefined;

    // Ajusta el dibujo al ancho del contenedor manteniendo píxeles nítidos:
    // 2 px de pantalla por píxel en celular y 3 en pantallas más anchas.
    const fit = () => {
      const width = svg.clientWidth;
      if (!width) return;
      const scale = width < 560 ? 2 : 3;
      const cols = Math.min(400, Math.floor(width / scale));
      const blockX = Math.round(cols / 2) - 6; // bloque (12 px) centrado
      const stop = blockX + 2; // robot (9 px) centrado bajo el bloque
      const exit = cols + 4; // fuera de cuadro por la derecha
      svg.setAttribute('viewBox', `0 0 ${cols} 60`);
      poi.setAttribute('transform', `translate(${blockX} 0)`);
      root.style.setProperty('--stop', `${stop}px`);
      root.style.setProperty('--exit', `${exit}px`);
      // Entrada y salida recorren la misma distancia en el mismo tiempo:
      // así el robot camina siempre a la misma velocidad.
      root.style.setProperty('--start', `${Math.min(-12, 2 * stop - exit)}px`);
      // Zona clicable: el bloque más 4 px de margen por lado (más fácil de tocar).
      Object.assign(blockHit.style, {
        left: `${((blockX - 4) / cols) * 100}%`,
        width: `${(20 / cols) * 100}%`,
        top: `${(20 / 60) * 100}%`,
        height: `${(20 / 60) * 100}%`,
      });
      // Mini bot pegado al borde derecho (7 px de ancho, 3 px de margen)
      const botX = cols - 10;
      miniBot.setAttribute('transform', `translate(${botX} 0)`);
      Object.assign(miniBotHit.style, {
        left: `${((botX - 3) / cols) * 100}%`,
        width: `${(13 / cols) * 100}%`,
        top: `${(42 / 60) * 100}%`,
        height: `${(15 / 60) * 100}%`,
      });
    };

    // Dibuja "[bloque] x N" con píxeles.
    const dibujarContador = () => {
      const rects: string[] = [];
      const px = (x: number, y: number, cls: string) =>
        rects.push(`<rect class="${cls}" x="${x}" y="${y}" width="1" height="1"/>`);
      // Icono: el bloque en miniatura (5 × 5: borde y un punto al centro)
      ['11111', '10001', '10101', '10001', '11111'].forEach((fila, y) =>
        [...fila].forEach((bit, x) => bit === '1' && px(x, y, 'c-icon')),
      );
      let x = 7;
      for (const ch of ['x', ...String(total)]) {
        GLIFOS[ch].forEach((fila, y) =>
          [...fila].forEach((bit, dx) => bit === '1' && px(x + dx, y, 'c-digit')),
        );
        x += 4;
      }
      counter.innerHTML = rects.join('');
    };

    const obtener = () => {
      total += 1;
      dibujarContador();
      // Destello suave de los dígitos al sumar
      counter.classList.remove('is-new');
      void counter.getBoundingClientRect();
      counter.classList.add('is-new');
    };

    // Elige un objeto al azar, distinto del anterior.
    const elegirObjeto = () => {
      const opciones = OBJETOS.filter((o) => o !== ultimo);
      ultimo = opciones[Math.floor(Math.random() * opciones.length)];
      root.dataset.item = ultimo;
    };

    const play = () => {
      clearTimeout(timer);
      elegirObjeto();
      if (motion.matches) {
        // Sin movimiento: el objeto aparece directo en su lugar.
        obtener();
        quizasFrase(0);
        return;
      }
      root.classList.remove('is-playing');
      void root.offsetWidth; // fuerza un reflow para reiniciar las animaciones CSS
      root.classList.add('is-playing');
      timer = window.setTimeout(obtener, SALIDA_MS);
      quizasFrase(SALIDA_MS + 300);
    };

    const sync = () => {
      if (button) button.hidden = motion.matches;
      if (motion.matches) root.classList.remove('is-playing');
    };

    fit();
    new ResizeObserver(fit).observe(svg);
    button?.addEventListener('click', play);
    // Botón nativo: ya responde a clic, Enter y Espacio.
    blockHit.hidden = false;
    blockHit.addEventListener('click', play);
    motion.addEventListener('change', sync);
    sync();
    dibujarContador();
    play();
  });
</script>

<style>
  .pixel-scene {
    --dur: 6s;
    --delay: 0.6s;
    --float: 2.8s;
    /* Valores sin JS (viewBox de 320); JS los recalcula según el ancho */
    --start: -12px;
    --stop: 156px;
    --exit: 324px;
    position: relative;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }
  .scene {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  /* Paleta del pixel art (tokens en global.css) */
  .ground { fill: var(--border); }
  .ground-px { fill: var(--steel-3); }
  .px-t { fill: var(--accent-light); }
  .px-h { fill: var(--steel-1); }
  .px-b { fill: var(--steel-2); }
  .px-s { fill: var(--steel-3); }
  .px-v { fill: var(--bg); }
  .px-e,
  .px-c,
  .px-a { fill: var(--accent); }
  .px-o { fill: var(--accent-deep); }
  .px-d { fill: #2a1d16; }
  .px-r { fill: #6e3c1b; }
  .px-l { fill: var(--accent-light); }
  .px-y { fill: var(--ember-core); }
  .px-k { fill: var(--accent-deep); }
  /* El "?" queda apagado en el estado final (el bloque ya fue usado) */
  .px-q { fill: var(--steel-2); }

  /* Montañas: más oscuras y tenues que el bosque para quedar al fondo */
  .mountains-far .m-body { fill: #191310; }
  .mountains-far .m-ridge { fill: var(--accent-deep); opacity: 0.25; }
  .mountains-near .m-body { fill: #1d1613; }
  .mountains-near .m-ridge { fill: var(--accent); opacity: 0.2; }

  /* Bosque: siluetas oscuras con detalles de neón naranja, siempre tenues */
  .t-leaf { fill: #2b211c; }
  .t-rim { fill: var(--accent); opacity: 0.55; }
  .t-led { fill: var(--accent); opacity: 0.6; }
  .forest-far { opacity: 0.6; }
  .forest-far .t-leaf { fill: #221a16; }
  /* El bosque lejano es solo silueta: el neón queda para la capa cercana */
  .forest-far .t-rim,
  .forest-far .t-led { display: none; }
  .forest-near { opacity: 0.85; }

  /* Objetos: se muestra solo el elegido (sin JS, la brasa) */
  .item { display: none; }
  .pixel-scene:not([data-item]) .item-brasa,
  .pixel-scene[data-item='brasa'] .item-brasa,
  .pixel-scene[data-item='moneda'] .item-moneda,
  .pixel-scene[data-item='engranaje'] .item-engranaje,
  .pixel-scene[data-item='chip'] .item-chip,
  .pixel-scene[data-item='vela'] .item-vela {
    display: inline;
  }

  /* Contador pixelado (los rects los crea JS: :global evita el scoping) */
  .counter :global(.c-icon) { fill: var(--accent); }
  .counter :global(.c-digit) { fill: var(--text-muted); }
  .counter.is-new :global(.c-digit) { animation: counter-new 0.9s ease-out; }
  @keyframes counter-new {
    from { fill: var(--accent-light); }
    to { fill: var(--text-muted); }
  }

  /* Estrellas: titileo muy lento y suave (nunca se apagan del todo) */
  .star-warm { fill: var(--text); }
  .star-orange { fill: var(--accent-light); }
  .star { opacity: 0.35; animation: twinkle 7s ease-in-out infinite; }
  .star.t2 { animation-duration: 9s; }
  .star.t3 { animation-duration: 11s; }
  .star-rays { opacity: 0.45; }
  @keyframes twinkle {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.6; }
  }

  /* Luz del objeto en el suelo (estado final: encendida) */
  .ground-light { fill: var(--accent); opacity: 0.8; }

  /* Mini bot dormido */
  .eye-closed { fill: var(--steel-2); }
  .eye-open { fill: var(--accent); opacity: 0; }
  .zz { fill: var(--text-muted); }
  .z { opacity: 0; animation: snore 4s ease-out infinite; }
  .z-2 { animation-delay: 2s; }
  @keyframes snore {
    0% { transform: translate(-3px, 45px); opacity: 0; }
    20% { opacity: 0.7; }
    100% { transform: translate(-7px, 35px); opacity: 0; }
  }
  /* Frase ocasional: etiqueta discreta centrada sobre el objeto */
  .phrase {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: fit-content;
    max-width: calc(100% - 6rem); /* deja libres el contador y el botón */
    margin: 0 auto;
    padding: 0.2rem 0.7rem;
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--text);
    text-align: center;
    background: rgba(20, 17, 16, 0.85);
    border: 1px solid var(--accent-deep);
    border-radius: 999px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    pointer-events: none;
  }
  .phrase.is-visible {
    opacity: 1;
    transform: none;
  }

  /* Zona de hover sobre el mini bot: abre un ojo y deja de roncar */
  .minibot-hit { position: absolute; }
  .pixel-scene:has(.minibot-hit:hover) .eye-open { opacity: 1; }
  .pixel-scene:has(.minibot-hit:hover) .eye-right { opacity: 0; }
  .pixel-scene:has(.minibot-hit:hover) .zz { visibility: hidden; }

  /* Botón invisible sobre el bloque: hover o foco = el bloque da un saltito */
  .block-hit {
    position: absolute;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }
  .block-hit[hidden] { display: none; }
  .pixel-scene:has(.block-hit:hover) .block-hop,
  .pixel-scene:has(.block-hit:focus-visible) .block-hop {
    animation: block-hop 0.35s ease-out;
  }
  @keyframes block-hop {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-3px); }
  }

  /* ---------- Estado final (por defecto) ----------
     El robot ya se fue y la brasa queda levitando sobre el bloque. */
  .robot-x { transform: translateX(var(--exit)); }
  .legs-b { opacity: 0; }
  .spark { opacity: 0; }
  .ember { animation: ember-float var(--float) ease-in-out infinite; }
  .ember-glow { opacity: 0.4; animation: glow-breathe var(--float) ease-in-out infinite; }

  /* ---------- Secuencia (solo con la clase .is-playing) ----------
     Línea de tiempo sobre --dur (6 s):
     0–2 s entra caminando · 2–2,7 s salta y golpea · 2,3 s sale la brasa
     3,4–5,4 s se va caminando · después la brasa sigue levitando. */
  .is-playing .robot-x { animation: robot-x var(--dur) var(--delay) both; }
  .is-playing .robot-y { animation: robot-y var(--dur) var(--delay) both; }
  .is-playing .block { animation: block-bump var(--dur) var(--delay) both; }
  .is-playing .px-q { animation: q-off var(--dur) var(--delay) both; }
  .is-playing .ember {
    animation:
      ember var(--dur) var(--delay) both,
      ember-float var(--float) ease-in-out calc(var(--delay) + var(--dur)) infinite;
  }
  .is-playing .ember-glow {
    animation:
      ember-glow var(--dur) var(--delay) both,
      glow-breathe var(--float) ease-in-out calc(var(--delay) + var(--dur)) infinite;
  }
  .is-playing .spark-1 { animation: spark var(--dur) var(--delay) both; }
  .is-playing .spark-2 { animation: spark var(--dur) calc(var(--delay) + 0.25s) both; }
  /* El suelo se ilumina cuando sale el objeto */
  .is-playing .ground-light { animation: ground-light var(--dur) var(--delay) both; }
  /* El mini bot aparece dormido cuando el robot ya salió de cuadro */
  .is-playing .minibot { animation: minibot-in var(--dur) var(--delay) both; }
  @keyframes ground-light {
    0%, 38.33% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0.8; }
  }
  @keyframes minibot-in {
    0%, 90% { opacity: 0; }
    100% { opacity: 1; }
  }
  /* Paso: alterna las piernas 8 veces en cada tramo caminando (0,25 s c/u) */
  .is-playing .legs-a {
    animation:
      step-a 0.25s steps(1) var(--delay) 8,
      step-a 0.25s steps(1) calc(var(--delay) + 3.4s) 8;
  }
  .is-playing .legs-b {
    animation:
      step-b 0.25s steps(1) var(--delay) 8,
      step-b 0.25s steps(1) calc(var(--delay) + 3.4s) 8;
  }

  @keyframes robot-x {
    /* Mismo número de pasos en ambos tramos = misma velocidad */
    0% { transform: translateX(var(--start)); animation-timing-function: steps(60); }
    33.33% { transform: translateX(var(--stop)); }
    56.67% { transform: translateX(var(--stop)); animation-timing-function: steps(60); }
    90%, 100% { transform: translateX(var(--exit)); }
  }
  @keyframes robot-y {
    0%, 33.33% { transform: translateY(0); animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1); }
    38.33% { transform: translateY(-8px); animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.3); }
    45%, 100% { transform: translateY(0); }
  }
  @keyframes block-bump {
    0%, 38.33% { transform: translateY(0); }
    40% { transform: translateY(-2px); }
    42.5%, 100% { transform: translateY(0); }
  }
  @keyframes q-off {
    0%, 38.33% { fill: var(--accent); }
    39%, 100% { fill: var(--steel-2); }
  }
  @keyframes ember {
    0%, 38.33% { transform: translateY(9px); opacity: 0; }
    38.34% { opacity: 1; animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1); }
    50% { transform: translateY(-5px); animation-timing-function: ease-in-out; }
    62% { transform: translateY(-1px); animation-timing-function: ease-in-out; }
    74% { transform: translateY(-3px); animation-timing-function: ease-in-out; }
    86%, 100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes ember-glow {
    0%, 38.33% { opacity: 0; }
    52% { opacity: 0.85; }
    100% { opacity: 0.4; }
  }
  /* Levitación infinita y suave de la brasa (y su brillo) */
  @keyframes ember-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  @keyframes glow-breathe {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.6; }
  }
  @keyframes spark {
    0%, 45% { transform: translateY(0); opacity: 0; }
    48% { opacity: 1; }
    70%, 100% { transform: translateY(-7px); opacity: 0; }
  }
  @keyframes step-a {
    0% { opacity: 0; }
    50% { opacity: 1; }
  }
  @keyframes step-b {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Botón pequeño de repetir, en la esquina superior derecha de la escena */
  .replay {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--text-muted);
    background: rgba(20, 17, 16, 0.6);
    border: 1px solid var(--border);
    border-radius: 50%;
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.3s var(--ease);
  }
  .replay:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: rotate(-30deg);
  }
  .replay[hidden] {
    display: none;
  }

  /* Movimiento reducido: solo el estado final (objeto quieto), sin botón.
     Las estrellas quedan fijas y el mini bot muestra una sola "z" quieta. */
  @media (prefers-reduced-motion: reduce) {
    .pixel-scene * {
      animation: none !important;
    }
    .z-1 {
      opacity: 0.6;
    }
    .replay {
      display: none;
    }
  }
</style>
