---
// Tarjeta de proyecto. Recibe una entrada de la colección "proyectos".
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils/url';
import StatusBadge from './StatusBadge.astro';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  indice: number;
}
const { proyecto, indice } = Astro.props;
const { titulo, resumen, tipo, estado, tecnologias } = proyecto.data;
const href = url(`/proyectos/${proyecto.id}/`);
---

<article class="card reveal">
  <div class="meta">
    <span class="idx">{String(indice + 1).padStart(2, '0')}</span>
    <span>{tipo}</span>
    <StatusBadge estado={estado} />
  </div>
  <h3>
    <a href={href}>{titulo}</a>
  </h3>
  <p class="resumen">{resumen}</p>
  {tecnologias.length > 0 && (
    <ul class="tags" aria-label="Tecnologías">
      {tecnologias.map((t) => <li>{t}</li>)}
    </ul>
  )}
  <span class="cta" aria-hidden="true">Ver caso de estudio →</span>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .card:hover {
    border-color: rgba(242, 140, 56, 0.45);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .idx {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin-right: 0.25rem;
  }
  h3 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }
  /* Toda la tarjeta es clicable a través del enlace del título */
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1; /* por encima de todo el contenido: el clic siempre llega al enlace */
    border-radius: var(--radius);
  }
  .resumen {
    color: var(--text-muted);
    max-width: var(--reading);
  }
  .cta {
    align-self: flex-start;
    pointer-events: none; /* al moverse con el hover no debe tapar el enlace */
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--accent);
    transition: transform 0.3s var(--ease);
  }
  .card:hover .cta {
    transform: translateX(4px);
  }
</style>
