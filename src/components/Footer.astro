---
import { perfil, contactos } from '../data/perfil';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>© {year} {perfil.nombre}</p>
    <ul class="links" aria-label="Contacto">
      {contactos.map((c) => (
        <li>
          <a href={c.href} {...(c.externo ? { target: '_blank', rel: 'noopener' } : {})}>
            {c.etiqueta}
            {c.externo && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
          </a>
        </li>
      ))}
    </ul>
    <p>Hecho con Astro · Valparaíso, Chile</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--section-gap);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 2rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    text-decoration-color: transparent;
  }
  .links a:hover {
    text-decoration-color: var(--accent);
  }
</style>
