---
import { perfil, contactos } from '../data/perfil';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="brand-line">
      <span class="brand" aria-hidden="true">S<span>.</span>G</span>
      © {year} {perfil.nombre}
    </p>
    <ul class="links" aria-label="Contacto">
      {contactos.map((c) => (
        <li>
          <a href={c.href} {...(c.externo ? { target: '_blank', rel: 'noopener' } : {})}>
            {c.etiqueta}
            {c.externo && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
          </a>
        </li>
      ))}
    </ul>
    <p>Hecho con Astro · Maipú, Chile</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--section-gap);
    /* Brillo cálido que sube desde abajo, sobre un tono apenas más claro */
    background:
      radial-gradient(40rem 10rem at 50% 100%, rgba(242, 140, 56, 0.1), transparent 70%),
      linear-gradient(to bottom, transparent, rgba(28, 22, 19, 0.7));
  }
  /* Línea superior con degradado naranja (igual que el encabezado) */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(196, 101, 31, 0.6) 25%,
      rgba(255, 179, 107, 0.7) 50%,
      rgba(196, 101, 31, 0.6) 75%,
      transparent
    );
  }
  .brand-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }
  .brand span {
    color: var(--accent);
    text-shadow: 0 0 12px rgba(242, 140, 56, 0.6);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 2rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    text-decoration-color: transparent;
  }
  .links a:hover {
    text-decoration-color: var(--accent);
  }
</style>
