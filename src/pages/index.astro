---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Icon from '../components/Icon.astro';
import { perfil, contactos } from '../data/perfil';

// Proyectos ordenados por "orden" (y luego por fecha, más reciente primero).
const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => a.data.orden - b.data.orden || b.data.inicio.getTime() - a.data.inicio.getTime(),
);

// Contacto: el correo se muestra con su icono y texto; el resto, solo icono.
const correo = contactos.find((c) => !c.externo)!;
const redes = contactos.filter((c) => c.externo);
---

<BaseLayout>
  <Hero />

  <Section id="proyectos" numero="01" titulo="Proyectos">
    <div class="projects">
      {proyectos.map((p, i) => <ProjectCard proyecto={p} indice={i} />)}
    </div>
  </Section>

  <Section id="sobre-mi" numero="02" titulo="Sobre mí">
    <div class="about reveal">
      {perfil.sobreMi.map((parrafo) => <p>{parrafo}</p>)}
    </div>
  </Section>

  <Section id="experiencia" numero="03" titulo="Experiencia">
    {perfil.experiencia.map((e) => <ExperienceItem {...e} />)}
  </Section>

  <Section id="aptitudes" numero="04" titulo="Aptitudes">
    <div class="skills">
      {perfil.aptitudes.map((g) => (
        <div class="skill-group reveal">
          <h3>{g.grupo}</h3>
          <ul class="tags">
            {g.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
      <div class="skill-group reveal">
        <h3>Idiomas</h3>
        <ul class="langs">
          {perfil.idiomas.map((l) => (
            <li><span>{l.idioma}</span> {l.nivel}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="contacto" numero="05" titulo="Contacto">
    <p class="contact-lead reveal">
      Estoy buscando práctica profesional. Si te interesa conversar, escríbeme.
    </p>
    <div class="contact reveal">
      <a class="mail" href={correo.href}>
        <Icon name="mail" size={22} />
        <span>{correo.texto}</span>
      </a>
      <ul class="socials">
        {redes.map((r) => (
          <li>
            <a
              class="icon-link"
              href={r.href}
              target="_blank"
              rel="noopener"
              aria-label={`${r.etiqueta} (se abre en una pestaña nueva)`}
              title={r.etiqueta}
            >
              <Icon name={r.icono} size={22} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>
</BaseLayout>

<style>
  .projects {
    display: grid;
    gap: 1.5rem;
  }
  .about {
    max-width: var(--reading);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
  }
  .about p + p {
    margin-top: 1.25rem;
  }
  .about p:not(:first-child) {
    color: var(--text-muted);
  }
  .skills {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 48rem) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 4rem;
    }
  }
  .skill-group h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }
  .langs {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--text-muted);
  }
  .langs li + li {
    margin-top: 0.5rem;
  }
  .langs span {
    color: var(--text);
    margin-right: 0.5rem;
  }
  .contact-lead {
    max-width: var(--reading);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.3;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.5rem;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1rem, 2.6vw, 1.15rem);
    overflow-wrap: anywhere;
  }
  .mail :global(.icon) {
    flex: none;
  }
  .socials {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Botón circular de 44 px: área táctil cómoda en celular */
  .icon-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-muted);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .icon-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
</style>
