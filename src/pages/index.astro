---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Icon from '../components/Icon.astro';
import { perfil, contactos } from '../data/perfil';

// Proyectos ordenados por "orden" (y luego por fecha, más reciente primero).
const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => a.data.orden - b.data.orden || b.data.inicio.getTime() - a.data.inicio.getTime(),
);
---

<BaseLayout>
  <Hero />

  <Section id="proyectos" numero="01" titulo="Proyectos">
    <div class="projects">
      {proyectos.map((p, i) => <ProjectCard proyecto={p} indice={i} />)}
    </div>
  </Section>

  <Section id="sobre-mi" numero="02" titulo="Sobre mí">
    <div class="about reveal">
      {perfil.sobreMi.map((parrafo) => <p>{parrafo}</p>)}
    </div>
  </Section>

  <Section id="experiencia" numero="03" titulo="Experiencia">
    {perfil.experiencia.map((e) => <ExperienceItem {...e} />)}
  </Section>

  <Section id="aptitudes" numero="04" titulo="Aptitudes">
    <div class="skills">
      {perfil.aptitudes.map((g) => (
        <div class="skill-group reveal">
          <h3>{g.grupo}</h3>
          <ul class="tags">
            {g.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
      <div class="skill-group reveal">
        <h3>Idiomas</h3>
        <ul class="langs">
          {perfil.idiomas.map((l) => (
            <li><span>{l.idioma}</span> {l.nivel}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="contacto" numero="05" titulo="Contacto">
    <p class="contact-lead reveal">
      Estoy buscando práctica profesional. Si te interesa conversar, escríbeme.
    </p>
    <!-- Los tres contactos con el mismo formato: icono en círculo y nombre debajo -->
    <ul class="contact reveal">
      {contactos.map((c) => (
        <li>
          <a
            class="contact-item"
            href={c.href}
            {...(c.externo ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="icon-circle"><Icon name={c.icono} size={22} /></span>
            <span class="label">{c.etiqueta}</span>
            {c.externo && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
          </a>
        </li>
      ))}
    </ul>
    <!-- La dirección queda a la vista (y se puede copiar), en texto discreto -->
    <p class="mail-text reveal">{perfil.enlaces.correo}</p>
  </Section>
</BaseLayout>

<style>
  .projects {
    display: grid;
    gap: 1.5rem;
  }
  .about {
    max-width: var(--reading);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
  }
  .about p + p {
    margin-top: 1.25rem;
  }
  .about p:not(:first-child) {
    color: var(--text-muted);
  }
  .skills {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 48rem) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 4rem;
    }
  }
  .skill-group h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }
  .langs {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--text-muted);
  }
  .langs li + li {
    margin-top: 0.5rem;
  }
  .langs span {
    color: var(--text);
    margin-right: 0.5rem;
  }
  .contact-lead {
    max-width: var(--reading);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.3;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.25rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  /* Círculo de 44 px: área táctil cómoda en celular */
  .icon-circle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .label {
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    transition: color 0.2s var(--ease);
  }
  .contact-item:hover {
    color: var(--text);
  }
  .contact-item:hover .icon-circle {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .mail-text {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
</style>
