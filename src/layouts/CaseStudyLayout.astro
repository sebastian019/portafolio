---
// Layout de un caso de estudio: cabecera con metadatos + contenido Markdown/MDX.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { perfil } from '../data/perfil';
import { url } from '../utils/url';
import StatusBadge from '../components/StatusBadge.astro';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}
const { proyecto } = Astro.props;
const { titulo, resumen, tipo, estado, inicio, actualizado, tecnologias, aviso } = proyecto.data;

// "octubre 2026" (mes en minúscula + año, sin "de")
const mesAnio = (fecha: Date) =>
  `${new Intl.DateTimeFormat('es-CL', { month: 'long', timeZone: 'UTC' }).format(fecha)} ${fecha.getUTCFullYear()}`;
const inicioTexto = mesAnio(inicio);
const actualizadoTexto = actualizado ? mesAnio(actualizado) : null;
---

<BaseLayout title={`${titulo} — ${perfil.nombre}`} description={resumen}>
  <article class="case container">
    <a class="back" href={url('/#proyectos')}>← Volver a proyectos</a>

    <header class="case-head reveal">
      <div class="head-meta">
        <p class="eyebrow">{tipo}</p>
        <StatusBadge estado={estado} />
      </div>
      <h1>{titulo}</h1>
      <p class="lead">{resumen}</p>

      <dl class="facts">
        <div><dt>Inicio</dt><dd>{inicioTexto}</dd></div>
        {tecnologias.length > 0 && (
          <div class="facts-wide">
            <dt>Tecnologías</dt>
            <dd>
              <ul class="tags">
                {tecnologias.map((t) => <li>{t}</li>)}
              </ul>
            </dd>
          </div>
        )}
      </dl>

      {actualizado && (
        <p class="updated">
          Última actualización:{' '}
          <time datetime={actualizado.toISOString().slice(0, 10)}>{actualizadoTexto}</time>
        </p>
      )}

      {aviso && (
        <p class="aviso" role="note">
          <span aria-hidden="true">!</span>
          {aviso}
        </p>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .case {
    padding-top: clamp(2rem, 6vw, 4rem);
  }
  .back {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .case-head {
    margin-top: clamp(2.5rem, 7vw, 4.5rem);
    max-width: 48rem;
  }
  .head-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.4rem, 8vw, 4.25rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .lead {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 2.4vw, 1.2rem);
    color: var(--text-muted);
  }
  .facts {
    display: grid;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 1.5rem 0;
    border-block: 1px solid var(--border);
  }
  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(2, auto);
      justify-content: start;
      column-gap: 3.5rem;
    }
  }
  .facts-wide {
    grid-column: 1 / -1;
  }
  .updated {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .facts .tags {
    margin-top: 0.5rem;
  }
  dt {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  dd {
    margin: 0.25rem 0 0;
  }
  dd::first-letter {
    text-transform: uppercase;
  }
  .aviso {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-top: 2rem;
    font-size: 0.95rem;
  }
  .aviso span {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Estilos del contenido Markdown (generado, por eso :global) */
  .prose {
    max-width: 44rem;
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  .prose :global(h2) {
    font-size: clamp(1.6rem, 4.5vw, 2.1rem);
    margin: clamp(3.5rem, 9vw, 5rem) 0 1.25rem;
    counter-increment: seccion;
  }
  .prose :global(h2::before) {
    content: counter(seccion, decimal-leading-zero);
    display: block;
    font-size: 0.95rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .prose {
    counter-reset: seccion;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p + p) {
    margin-top: 1.1rem;
  }
  .prose :global(ul) {
    padding-left: 1.1rem;
  }
  .prose :global(li + li) {
    margin-top: 0.4rem;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
</style>
